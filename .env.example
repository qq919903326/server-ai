# Required for remote deployment; optional on localhost. Enter it in the UI.
APP_TOKEN=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MIMO_API_KEY=
AI_DATA_DIR=./data
# Chat content stays in the browser by default. UI setting can explicitly enable.
STORE_SESSIONS=false
# Optional tokens for manually configured database MCP connections.
MYSQL_MCP_TOKEN=
POSTGRES_MCP_TOKEN=
# Optional token for the separately deployed P2P file MCP.
FILE_MCP_TOKEN=
# Optional WebRTC ICE servers for the integrated local project assistant (JSON).
FILE_ICE_SERVERS_JSON=[]
