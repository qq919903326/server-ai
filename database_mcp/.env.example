# MySQL connection (use a SELECT-only account)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_MCP_TOKEN=
MYSQL_QUERY_TIMEOUT_MS=15000
# Optional CA path; when set, verify certificate and hostname.
MYSQL_SSL_CA=

# PostgreSQL connection (use a SELECT-only account)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_SCHEMA=public
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_MCP_TOKEN=
POSTGRES_QUERY_TIMEOUT_MS=15000
POSTGRES_SSLMODE=require
# Set sslmode=verify-full and the CA path for certificate verification.
POSTGRES_SSL_CA=
